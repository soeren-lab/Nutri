# Kopiere diese Datei nach ".env" und trage EIGENE, lange Zufallswerte ein (nie in Git!).
DB_ROOT_PASSWORD=bitte-aendern
DB_PASSWORD=bitte-aendern
# mindestens 32 Zeichen, z. B. per: openssl rand -hex 32
JWT_SECRET=bitte-aendern-mindestens-32-zeichen-lang
# Nach dem Anlegen aller Konten auf "false" setzen, dann kann sich niemand Fremdes registrieren.
ALLOW_SIGNUP=true

# Foto-Scan: dein eigener Anthropic-API-Schlüssel (nie in den Chat oder in Git!).
ANTHROPIC_API_KEY=
# Optional anderes Modell, z. B. claude-haiku-5-5 (günstiger)
PHOTO_SCAN_MODEL=claude-sonnet-5-5
