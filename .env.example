# Kopiere diese Datei nach ".env" (steht in .gitignore) und trage deine Werte ein.

# Adresse der NAS-API im Heimnetz (ohne abschließenden Slash), z. B. http://192.168.178.50:3000
VITE_API_URL=http://<NAS-IP>:3000,http://<Tailscale-IP>:3000

# Nur für den Cloudflare-Worker (Server-Funktionen wie Foto-Scan), als Worker-Secrets setzen:
#   JWT_SECRET   = derselbe Wert wie in nas-api/.env
#   NAS_API_URL  = von außen erreichbare API-Adresse (im reinen Heimnetz-Betrieb nicht erreichbar)
